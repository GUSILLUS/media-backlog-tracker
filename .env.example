# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the server listens on (optional locally; hosting sets it in production)
PORT=3000

# Postgres connection string — you'll create this on Day 2.
# Get a free one at https://neon.tech (or Railway). Looks like:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL=

JWT_SECRET = 

NODE_ENV= 
